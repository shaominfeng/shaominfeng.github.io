---
import '../styles/home.css';
import { SITE, getBlogUrl } from '../data/site';
import { PROJECTS, PROJECT_SLOTS } from '../data/projects';
import { getWritingFeed, writingBlock } from '../data/writing';
import { TIMELINE } from '../data/timeline';
import { getGithubStats } from '../lib/github';
import { UI, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const h = t.home;
const isZh = lang === 'zh';

const stats = await getGithubStats();

const stages = h.stages;
const workPath = localePath('/work/', lang);

/**
 * 写作区完全由博客的 /blog/writing.json 驱动 —— 本仓库不保存任何文章副本。
 * 拿不到清单时降级成“系列 / 单篇 / 全部”三个入口，不阻塞构建。
 */
const feed = await getWritingFeed();
const block = writingBlock(feed, lang);

const articles = (block?.latest ?? []).map((item) => ({
  title: item.title,
  subtitle: item.subtitle || item.seriesTitle,
  excerpt: item.excerpt,
  meta: [item.kind === 'essay' ? (isZh ? '单篇' : 'Essay') : item.part || item.seriesTitle, `${item.minutes} min`]
    .filter(Boolean)
    .join(' · '),
  tags: item.tags,
  date: item.date,
  href: SITE.siteUrl + item.path,
}));

const articleCount = block ? String(block.totals.chapters + block.totals.essays) : h.gwArticles.count;

const writingStat = block
  ? h.numbers.writingStat(
      block.totals.chapters,
      block.totals.essays,
      block.totals.words,
      block.totals.wordsUnit,
      block.totals.sources
    )
  : h.numbers.writing;

const fallbackLinks = [
  { label: h.writingFallback.series, href: getBlogUrl(lang) + 'ai-evolution/' },
  { label: h.writingFallback.essays, href: getBlogUrl(lang) + 'essays/' },
  { label: h.writingFallback.all, href: getBlogUrl(lang) },
];

/** 时间线按语言取文案 */
const milestones = TIMELINE.map((item) => (isZh ? item : { ...item, ...item.en }));
---

<section class="hero">
  <div class="shell hero-grid">
    <div class="hero-copy">
      <p class="hero-kicker">{h.kicker}</p>
      <h1>
        <span class="name">{SITE.name}</span>
        <span class="en">{h.portfolio}</span>
      </h1>
      <p class="hero-line">
        {h.heroLineA}<br />{h.heroLineB}<em>{h.heroLineEm}</em>{h.heroLineTail}
      </p>
      <p class="hero-desc">{h.heroDesc}</p>
      <div class="hero-actions">
        <a class="btn btn-light" href={workPath}>{h.ctaWork} <span aria-hidden="true">→</span></a>
        <a class="btn btn-outline-light" href={getBlogUrl(lang)}>{h.ctaRead}</a>
      </div>
      <p class="hero-note">
        {h.notes.map((note) => <span>{note}</span>)}
      </p>
    </div>

    <div class="hero-visual">
      <div class="field-card">
        <div class="fc-top">
          <span>{h.fieldNotes}</span>
          <span>{h.fieldRange}</span>
        </div>
        <ol class="stages">
          {stages.map((stage, index) => (
            <li class={index === stages.length - 1 ? 'active' : undefined}>
              <span class="yr">{stage.year}</span>
              <span class="stage">{stage.label}</span>
              <span class="dot" aria-hidden="true"></span>
            </li>
          ))}
        </ol>
        <div class="fc-foot">
          <span>{h.contextWindow}</span>
          <span><b>4K</b> → <b>2M</b></span>
        </div>
        <div class="fc-stat" aria-hidden="true">
          <strong>500×</strong>
          <span>{h.growth}</span>
        </div>
        <div class="seal-float" aria-hidden="true">AS</div>
      </div>
    </div>
  </div>
</section>

<section class="shell gateway" aria-label={h.gatewayAria}>
  <a class="gateway-card gw-projects" href={workPath}>
    <span class="gw-label">{h.gwProjects.label}</span>
    <h2 class="gw-title">{h.gwProjects.title}</h2>
    <p class="gw-desc">{h.gwProjects.desc}</p>
    <span class="gw-foot"><span>{h.gwProjects.foot}</span><span class="gw-arrow">→</span></span>
    <span class="gw-count" aria-hidden="true">—</span>
  </a>
  <a class="gateway-card gw-articles" href={getBlogUrl(lang)}>
    <span class="gw-label">{h.gwArticles.label}</span>
    <h2 class="gw-title">{h.gwArticles.title}</h2>
    <p class="gw-desc">{h.gwArticles.desc}</p>
    <span class="gw-foot"><span>{h.gwArticles.foot}</span><span class="gw-arrow">→</span></span>
    <span class="gw-count" aria-hidden="true">{articleCount}</span>
  </a>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {Array.from({ length: 2 }).map(() => (
      <>
        <span class="ticker-item">AI Agent</span>
        <span class="ticker-item">MCP</span>
        <span class="ticker-item">Agent Skills</span>
        <span class="ticker-item">Context Engineering</span>
        <span class="ticker-item">Cloud Security</span>
        <span class="ticker-item">Developer Experience</span>
        <span class="ticker-item">2022—2026</span>
      </>
    ))}
  </div>
</div>

<section class="shell section" id="work">
  <div class="section-head">
    <div class="section-head-left">
      <span class="section-index">01</span>
      <h2 class="section-title">{h.sectionProjects}</h2>
    </div>
    <a class="section-note" href={workPath}>{h.sectionProjectsNote}</a>
  </div>

  <div class="work-grid work-grid-projects">
    {PROJECTS.length > 0
      ? PROJECTS.map((project) => (
          <article class="work-card">
            <a class="wc-media" href={workPath + project.slug + '/'} aria-label={h.viewProject(project.title)}>
              {project.cover ? (
                <img src={project.cover} alt={project.coverAlt} width="1400" height="972" loading="lazy" />
              ) : (
                <div class="metric-cover" aria-hidden="true">
                  {project.metrics.map((metric) => (
                    <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
                  ))}
                </div>
              )}
            </a>
            <div class="wc-body">
              <span class="project-index">Project {project.index} / {project.year} · {project.status}</span>
              <h3 class="wc-title"><a href={workPath + project.slug + '/'}>{project.title}</a></h3>
              <p class="wc-desc">{project.tagline}</p>
              <div class="wc-metrics">
                {project.metrics.slice(0, 3).map((metric) => (
                  <span><b>{metric.value}</b> {metric.label}</span>
                ))}
              </div>
              <div class="wc-links">
                {project.demo && (
                  <a class="text-link" href={project.demo} target={project.demo.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                    {project.demoLabel} {project.demo.startsWith('http') ? '↗' : '→'}
                  </a>
                )}
                <a class="text-link" href={workPath + project.slug + '/'}>{h.detail}</a>
              </div>
            </div>
          </article>
        ))
      : Array.from({ length: PROJECT_SLOTS }).map((_, slot) => (
          <article class="work-card is-placeholder">
            <div class="wc-media" aria-hidden="true">
              <span class="placeholder-mark">Slot {String(slot + 1).padStart(2, '0')}</span>
            </div>
            <div class="wc-body">
              <span class="project-index">{h.placeholderIndex(String(slot + 1).padStart(2, '0'))}</span>
              <h3 class="wc-title is-muted">{h.placeholderTitle}</h3>
              <p class="wc-desc">{h.placeholderDesc}</p>
              <div class="wc-links">
                <span class="placeholder-mark">{h.comingSoon}</span>
              </div>
            </div>
          </article>
        ))}
  </div>

  <div class="section-foot">
    <span>{h.projectsFoot}</span>
    <a class="text-link" href={workPath}>{h.projectsFootLink}</a>
  </div>
</section>

<section class="shell section" id="writing">
  <div class="section-head">
    <div class="section-head-left">
      <span class="section-index">02</span>
      <h2 class="section-title">{h.sectionWriting}</h2>
    </div>
    <a class="section-note" href={getBlogUrl(lang)}>{h.sectionWritingNote}</a>
  </div>

  <div class="writing-list">
    {articles.length > 0
      ? articles.map((article, index) => (
          <a class="writing-row" href={article.href} target="_blank" rel="noopener noreferrer">
            <span class="wr-num">{String(index + 1).padStart(2, '0')}</span>
            <span>
              <span class="wr-title">{article.title}</span>
              <span class="wr-sub">{article.subtitle}</span>
              <span class="wr-excerpt">{article.excerpt}</span>
            </span>
            <span class="wr-meta">
              <span>{article.meta}</span>
              <span class="wr-tags">
                {article.tags.map((tag) => <span class="tag">{tag}</span>)}
              </span>
            </span>
          </a>
        ))
      : fallbackLinks.map((link, index) => (
          <a class="writing-row" href={link.href} target="_blank" rel="noopener noreferrer">
            <span class="wr-num">{String(index + 1).padStart(2, '0')}</span>
            <span>
              <span class="wr-title">{link.label}</span>
              <span class="wr-sub">{h.writingFallbackEmpty}</span>
            </span>
            <span class="wr-meta"><span>↗</span></span>
          </a>
        ))}
  </div>

  <div class="writing-footer">
    <p>{h.writingFoot}</p>
    <a class="text-link" href={getBlogUrl(lang)} target="_blank" rel="noopener noreferrer">{h.writingFootLink}</a>
  </div>
</section>

<section class="numbers">
  <div class="shell numbers-inner">
    <div class="numbers-grid">
      <div class="number">
        <strong>4000+</strong>
        <span>{h.numbers.users}</span>
      </div>
      <div class="number">
        <strong>10+</strong>
        <span>{h.numbers.mcp}</span>
      </div>
      <div class="number">
        <strong>{stats.stars}<em style="font-size:0.38em;font-style:normal;color:var(--accent)">★</em></strong>
        <span>{h.numbers.stars}</span>
      </div>
      <div class="number">
        <strong>3</strong>
        <span>{h.numbers.years}</span>
      </div>
    </div>
    <div class="community-bar">
      <span>GitHub · {stats.stars} stars / {stats.followers} followers / {stats.repos} public repos</span>
      <span>{writingStat}</span>
      <a href={SITE.github} target="_blank" rel="noopener noreferrer">{h.numbers.follow}</a>
    </div>
  </div>
</section>

<section class="shell section" id="timeline">
  <div class="section-head">
    <div class="section-head-left">
      <span class="section-index">03</span>
      <h2 class="section-title">{h.timelineTitle}</h2>
    </div>
    <span class="section-note">{h.timelineNote}</span>
  </div>

  <div class="timeline">
    {milestones.map((item) => (
      <div class="tl-row">
        <div class="tl-year">
          <strong>{item.year}</strong>
          <span>{item.date}</span>
        </div>
        <div class="tl-main">
          <h3>{item.title}</h3>
          <p>{item.description}</p>
        </div>
        <span class="tag tl-tag">{item.tag}</span>
      </div>
    ))}
  </div>
</section>

<section class="shell section" id="about">
  <div class="section-head">
    <div class="section-head-left">
      <span class="section-index">04</span>
      <h2 class="section-title">{h.aboutTitle}</h2>
    </div>
    <a class="section-note" href={localePath('/about/', lang)}>{h.aboutNote}</a>
  </div>

  <div class="about-grid">
    <div class="about-copy">
      <p class="about-statement">{h.aboutStatementA}<br />{h.aboutStatementB}</p>
      {h.aboutParas.map((paragraph) => <p>{paragraph}</p>)}
      <a class="text-link" href={localePath('/about/', lang)}>{h.aboutMore}</a>
      <div class="contact-line">
        <a href={'mailto:' + SITE.email}>Email</a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={getBlogUrl(lang)}>{h.contactBlog}</a>
      </div>
    </div>

    <div>
      <div class="skill-block">
        <h3>AI / Agent</h3>
        <ul class="skill-list">
          <li>Claude Code</li>
          <li>MCP</li>
          <li>Agent Skills</li>
          <li>RAG</li>
          <li>Prompt / Context</li>
        </ul>
      </div>
      <div class="skill-block" style="margin-top:12px">
        <h3>Engineering</h3>
        <ul class="skill-list">
          <li>TypeScript</li>
          <li>Node.js</li>
          <li>React</li>
          <li>Python</li>
          <li>Java</li>
        </ul>
      </div>
      <div class="skill-block" style="margin-top:12px">
        <h3>Platform / Security</h3>
        <ul class="skill-list">
          <li>API Gateway</li>
          <li>OIDC</li>
          <li>Docker / K8s</li>
          <li>Cost / Observability</li>
          <li>Cloud Security</li>
        </ul>
      </div>
    </div>
  </div>
</section>
