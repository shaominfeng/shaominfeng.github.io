---
import { SITE, getNav } from '../data/site';
import { UI, getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url.pathname);
const t = UI[lang];
const nav = getNav(lang);
---

<footer class="site-footer">
  <div class="shell">
    <div class="footer-top">
      <div class="footer-brand">
        <span class="seal" aria-hidden="true">AS</span>
        <div>
          <strong>{SITE.name}</strong>
          <span>{t.meta.role}</span>
        </div>
      </div>
      <div class="footer-links">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={'mailto:' + SITE.email}>Email</a>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <a href={SITE.blogUrl + 'rss.xml'} target="_blank" rel="noopener noreferrer">RSS ↗</a>
      </div>
      <p class="footer-note">
        {t.footer.note}
        <em>{t.footer.noteEm}</em>
      </p>
    </div>
    <div class="footer-bottom">
      <span>© 2026 {SITE.name}</span>
      <span>{t.footer.builtWith}</span>
      <span>{t.footer.updated} {SITE.updated}</span>
    </div>
  </div>
</footer>
