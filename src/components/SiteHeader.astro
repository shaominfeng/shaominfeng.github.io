---
import { SITE, getNav } from '../data/site';
import { UI, getLangFromUrl, swapLangPath } from '../i18n/ui';

const path = Astro.url.pathname;
const lang = getLangFromUrl(path);
const t = UI[lang];
const nav = getNav(lang);
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href={lang === 'zh' ? '/' : '/en/'}>
      <span class="seal" aria-hidden="true">AS</span>
      <span class="brand-copy">
        <strong>{SITE.name}</strong>
        <span>{t.nav.brandSub}</span>
      </span>
    </a>

    <nav class="site-nav" aria-label={t.nav.aria}>
      {nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <span class="lang-switch" role="group" aria-label={lang === 'zh' ? '语言 / Language' : 'Language / 语言'}>
        {lang === 'zh' ? (
          <span class="is-current" aria-current="true">中</span>
        ) : (
          <a href={swapLangPath(path, 'zh')} hreflang="zh-CN" lang="zh-CN">中</a>
        )}
        <span class="lang-sep" aria-hidden="true">/</span>
        {lang === 'en' ? (
          <span class="is-current" aria-current="true">EN</span>
        ) : (
          <a href={swapLangPath(path, 'en')} hreflang="en" lang="en">EN</a>
        )}
      </span>
      <a class="nav-ext" href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      <a class="nav-cta" href={'mailto:' + SITE.email}>{t.nav.cta} <span aria-hidden="true">→</span></a>
    </nav>
  </div>
</header>
