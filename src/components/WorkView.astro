---
import { PROJECTS, PROJECT_SLOTS } from '../data/projects';
import { SITE } from '../data/site';
import { UI, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = UI[lang];
const w = t.work;
const workPath = localePath('/work/', lang);
---

<div class="shell page-hero">
  <p class="label">{w.label}</p>
  <h1>{w.heading}</h1>
  <p>{w.intro}</p>
  <div class="page-meta">
    <span>{w.metaCount(PROJECTS.length)}</span>
    <span>{w.metaSlots(PROJECT_SLOTS)}</span>
    <span>{w.metaFoot}</span>
  </div>
</div>

<section class="shell section">
  <div class="work-list">
    {PROJECTS.length > 0
      ? PROJECTS.map((project) => (
          <article class="work-feature">
            <div class="wf-copy">
              <span class="project-index">Project {project.index} / {project.year} · {project.status}</span>
              <h2 class="wf-title"><a href={workPath + project.slug + '/'}>{project.title}</a></h2>
              <p class="wf-tagline">{project.tagline}</p>
              <p class="wf-desc">{project.description}</p>
              <div class="wf-metrics">
                {project.metrics.slice(0, 3).map((metric) => (
                  <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
                ))}
              </div>
              <div class="wf-links">
                {project.demo && (
                  <a class="text-link" href={project.demo} target={project.demo.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                    {project.demoLabel} ↗
                  </a>
                )}
                <a class="text-link" href={workPath + project.slug + '/'}>{w.detail}</a>
                {project.repo && <a class="text-link" href={project.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
              </div>
            </div>
            <a class="wf-media" href={workPath + project.slug + '/'} aria-label={project.title}>
              {project.cover ? (
                <img src={project.cover} alt={project.coverAlt} loading="lazy" />
              ) : (
                <div class="metric-cover" aria-hidden="true">
                  {project.metrics.map((metric) => (
                    <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
                  ))}
                </div>
              )}
              <span class="media-caption">{project.coverCaption ?? project.en}</span>
            </a>
          </article>
        ))
      : Array.from({ length: PROJECT_SLOTS }).map((_, slot) => (
          <article class="work-feature is-placeholder">
            <div class="wf-copy">
              <span class="project-index">{w.placeholderIndex(String(slot + 1).padStart(2, '0'))}</span>
              <h2 class="wf-title is-muted">{w.placeholderTitle}</h2>
              <p class="wf-tagline">{w.placeholderTagline}</p>
              <p class="wf-desc">{w.placeholderDesc}</p>
              <div class="wf-links">
                <span class="placeholder-mark">{t.home.comingSoon}</span>
              </div>
            </div>
            <div class="wf-media" aria-hidden="true">
              <span class="placeholder-mark">Slot {String(slot + 1).padStart(2, '0')}</span>
              <span class="media-caption">{w.placeholderTitle}</span>
            </div>
          </article>
        ))}
  </div>
</section>

<section class="shell section" id="building">
  <div class="section-head">
    <div class="section-head-left">
      <span class="section-index">02</span>
      <h2 class="section-title">{w.roadmapTitle}</h2>
    </div>
    <span class="section-note">{w.roadmapNote}</span>
  </div>

  <div class="future-grid">
    {w.roadmap.map((item, index) => (
      <div class="future-card">
        <span class="future-num">{String(index + 1).padStart(2, '0')}</span>
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
        <span class="tag">{item.tag}</span>
      </div>
    ))}
  </div>

  <div class="section-foot">
    <span>{w.roadmapFoot}</span>
    <a class="text-link" href={'mailto:' + SITE.email}>{w.roadmapFootLink}</a>
  </div>
</section>
