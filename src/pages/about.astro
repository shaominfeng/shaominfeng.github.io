---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutView from '../components/AboutView.astro';
import { SITE } from '../data/site';
import { UI } from '../i18n/ui';

const t = UI.zh;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: '关于 Allen Shao',
  description: t.meta.aboutDescription,
  url: new URL('/about/', Astro.site).toString(),
  mainEntity: {
    '@type': 'Person',
    name: SITE.name,
    alternateName: '邵敏峰',
    jobTitle: '全栈工程师 / AI Agent 与云安全',
    email: 'mailto:' + SITE.email,
    url: SITE.siteUrl,
    sameAs: [SITE.github],
  },
};
---

<BaseLayout title={t.meta.aboutTitle} description={t.meta.aboutDescription} structuredData={structuredData}>
  <AboutView lang="zh" />
</BaseLayout>
