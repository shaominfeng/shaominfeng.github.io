---
// 英文项目详情页。PROJECTS 为空时不生成任何页面；
// 以后往 PROJECTS 里加项目并补上 enText，本页立即生效。
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { PROJECTS, projectText } from '../../../data/projects';
import { SITE } from '../../../data/site';

export async function getStaticPaths() {
  return PROJECTS.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: PROJECTS[(index + 1) % PROJECTS.length],
    },
  }));
}

const { project, next } = Astro.props;
const index = PROJECTS.findIndex((item) => item.slug === project.slug);
const text = projectText(project, 'en');

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: text.title,
  alternateName: project.title,
  description: text.description,
  dateCreated: project.year,
  inLanguage: 'en',
  creator: {
    '@type': 'Person',
    name: SITE.name,
    url: SITE.siteUrl,
  },
  url: new URL('/en/work/' + project.slug + '/', Astro.site).toString(),
  keywords: project.stack.join(', '),
};
---

<BaseLayout title={text.title} description={text.description} type="article" structuredData={structuredData}>
  <div class="shell case-hero">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/en/">Home</a>
      <span>/</span>
      <a href="/en/work/">Projects</a>
      <span>/</span>
      <span>{String(index + 1).padStart(2, '0')}</span>
    </nav>

    <span class="case-label">Project {project.index} · {project.en}</span>
    <h1>{text.title}</h1>
    <p class="case-tagline">{text.tagline}</p>
    <p class="case-desc">{text.description}</p>

    <dl class="case-meta">
      <div><dt>Year</dt><dd>{project.year}</dd></div>
      <div><dt>Role</dt><dd>{text.role}</dd></div>
      <div><dt>Status</dt><dd>{text.status}</dd></div>
      <div><dt>Stack</dt><dd>{project.stack.join(' · ')}</dd></div>
    </dl>
  </div>

  {project.cover && (
    <div class="shell">
      <figure class="case-cover">
        <img src={project.cover} alt={project.coverAlt} width="1400" height="764" loading="eager" />
        <figcaption>
          <span>{project.coverCaption}</span>
          <span>{project.en}</span>
        </figcaption>
      </figure>
    </div>
  )}

  <div class="shell case-grid">
    <aside class="case-side">
      <ul class="info-list">
        <li><dt>Project</dt><dd>{text.title}</dd></li>
        <li><dt>Year</dt><dd>{project.year}</dd></li>
        <li><dt>Role</dt><dd>{text.role}</dd></li>
        <li><dt>Status</dt><dd>{text.status}</dd></li>
        <li><dt>Stack</dt><dd>{project.stack.join(', ')}</dd></li>
      </ul>
      {project.demo ? (
        <a class="text-link" href={project.demo} target={project.demo.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
          {text.demoLabel} ↗
        </a>
      ) : (
        <span class="case-note">{text.note}</span>
      )}
      {project.repo && (
        <a class="text-link" style="margin-left:16px" href={project.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      )}
    </aside>

    <div class="case-main">
      <div class="case-metrics">
        {text.metrics.map((metric) => (
          <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
        ))}
      </div>

      {text.sections.map((section) => (
        <section class="case-section">
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
        </section>
      ))}

      <div class="case-links">
        {project.demo && (
          <a class="btn btn-primary" href={project.demo} target={project.demo.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
            {text.demoLabel} <span aria-hidden="true">→</span>
          </a>
        )}
        {project.repo && (
          <a class="btn btn-ghost" href={project.repo} target="_blank" rel="noopener noreferrer">Source code ↗</a>
        )}
        <a class="btn btn-ghost" href="/en/work/">All projects</a>
      </div>

      {text.note && <p class="case-note">{text.note}</p>}

      <a class="next-project" href={'/en/work/' + next.slug + '/'}>
        <div>
          <small>Next project</small>
          <strong>{projectText(next, 'en').title} →</strong>
        </div>
        <span class="mono">{next.index}</span>
      </a>
    </div>
  </div>
</BaseLayout>
