---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeView from '../components/HomeView.astro';
import { SITE } from '../data/site';
import { UI } from '../i18n/ui';

const t = UI.zh;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: '邵敏峰',
  jobTitle: '全栈工程师 / AI Agent 与云安全',
  description: t.meta.siteDescription,
  url: SITE.siteUrl,
  email: 'mailto:' + SITE.email,
  sameAs: [SITE.github, SITE.blogUrl],
  knowsAbout: ['AI Agent', 'MCP', 'Agent Skills', '云安全', '平台工程', 'TypeScript'],
};
---

<BaseLayout title={SITE.name} description={t.meta.siteDescription} structuredData={structuredData}>
  <HomeView lang="zh" />
</BaseLayout>
