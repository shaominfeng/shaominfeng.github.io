---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../data/site';
import { PROJECTS } from '../data/projects';
import { FEATURED_ARTICLES } from '../data/articles';
import { TIMELINE } from '../data/timeline';
import { getGithubStats } from '../lib/github';

const stats = await getGithubStats();
const report = PROJECTS[0];
const aiHot = PROJECTS[1];
const platform = PROJECTS[2];

const stages = [
  { year: '2022', label: '对话 AI' },
  { year: '2023', label: '长文本 AI' },
  { year: '2024', label: '推理 AI' },
  { year: '2025', label: 'Agent AI' },
  { year: '2026', label: '协作 AI', active: true },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.en,
  jobTitle: '全栈工程师 / AI Agent 与云安全',
  description: SITE.description,
  url: SITE.siteUrl,
  email: 'mailto:' + SITE.email,
  sameAs: [SITE.github, SITE.reportUrl],
  knowsAbout: ['AI Agent', 'MCP', 'Agent Skills', '云安全', '平台工程', 'TypeScript'],
};
---

<BaseLayout title={SITE.name} description={SITE.description} structuredData={structuredData}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">Full-stack · AI Agent / Cloud security</p>
        <h1>
          <span class="name">邵敏峰</span>
          <span class="en">Allen Shao</span>
        </h1>
        <p class="hero-line">把 AI 从「会聊天」<br />做成<em>「能干活」</em>。</p>
        <p class="hero-desc">
          3 年 AI 平台与 Agent 工程实践。做平台，也写代码；把踩过的坑，写成 2.1 万字的技术长文。
        </p>
        <div class="hero-actions">
          <a class="btn btn-light" href="/work/">看作品 <span aria-hidden="true">→</span></a>
          <a class="btn btn-outline-light" href="/writing/">读文章</a>
        </div>
        <p class="hero-note">
          <span>开放交流：AI Agent / 平台工程</span>
          <span>Base in China</span>
          <span>中文 / English</span>
        </p>
      </div>

      <div class="hero-visual">
        <div class="field-card">
          <div class="fc-top">
            <span>Field notes / AI</span>
            <span>2022—2026</span>
          </div>
          <ol class="stages">
            {stages.map((stage) => (
              <li class={stage.active ? 'active' : undefined}>
                <span class="yr">{stage.year}</span>
                <span class="stage">{stage.label}</span>
                <span class="dot" aria-hidden="true"></span>
              </li>
            ))}
          </ol>
          <div class="fc-foot">
            <span>Context window</span>
            <span><b>4K</b> → <b>2M</b></span>
          </div>
          <div class="fc-stat" aria-hidden="true">
            <strong>500×</strong>
            <span>Three-year growth</span>
          </div>
          <div class="seal-float" aria-hidden="true">邵</div>
        </div>
      </div>
    </div>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {Array.from({ length: 2 }).map(() => (
        <>
          <span class="ticker-item">AI Agent</span>
          <span class="ticker-item">MCP</span>
          <span class="ticker-item">Agent Skills</span>
          <span class="ticker-item">Context Engineering</span>
          <span class="ticker-item">Cloud Security</span>
          <span class="ticker-item">Developer Experience</span>
          <span class="ticker-item">2022—2026</span>
        </>
      ))}
    </div>
  </div>

  <section class="shell section" id="work">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">01</span>
        <h2 class="section-title">精选作品</h2>
      </div>
      <a class="section-note" href="/work/">全部项目 →</a>
    </div>

    <article class="work-feature">
      <div class="wf-copy">
        <span class="project-index">Project 01 / 2026 · 已发布</span>
        <h3 class="wf-title"><a href="/work/ai-evolution/">从对话到协作</a></h3>
        <p class="wf-tagline">AI 大模型三年演进全记录</p>
        <p class="wf-desc">
          14 章、2.1 万字。把 2022.11 到 2026.01 的模型、协议与产品放回同一条时间线，解释每一次跃迁解决了什么，又留下了什么。
        </p>
        <div class="wf-metrics">
          <div><strong>14</strong><span>章</span></div>
          <div><strong>2.1 万</strong><span>字</span></div>
          <div><strong>500×</strong><span>上下文增长</span></div>
        </div>
        <div class="wf-links">
          <a class="text-link" href={report.demo} target="_blank" rel="noopener noreferrer">在线阅读 ↗</a>
          <a class="text-link" href="/work/ai-evolution/">项目详情 →</a>
          <a class="text-link" href={report.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        </div>
      </div>
      <a class="wf-media" href={report.demo} target="_blank" rel="noopener noreferrer" aria-label="在线打开《从对话到协作》">
        <img src={report.cover} alt={report.coverAlt} width="1400" height="764" loading="eager" />
        <span class="media-caption">LIVE REPORT · shaominfeng.github.io/ai-evolution</span>
      </a>
    </article>

    <div class="work-grid">
      <article class="work-card">
        <a class="wc-media" href={aiHot.demo} target="_blank" rel="noopener noreferrer" aria-label="在线打开 AI HOT 每日晨报">
          <img src={aiHot.cover} alt={aiHot.coverAlt} width="1400" height="972" loading="lazy" />
        </a>
        <div class="wc-body">
          <span class="project-index">Project 02 / 2026.07 · 15 期归档</span>
          <h3 class="wc-title"><a href="/work/ai-hot-daily/">AI HOT · 每日晨报</a></h3>
          <p class="wc-desc">每天 6 条 AI 新闻，压成 5 分钟晨报。单文件 HTML，按月份归档，无后端、无数据库。</p>
          <div class="wc-metrics">
            <span><b>15</b> 期归档</span>
            <span><b>5</b> 分钟读完</span>
            <span><b>0</b> 依赖</span>
          </div>
          <div class="wc-links">
            <a class="text-link" href={aiHot.demo} target="_blank" rel="noopener noreferrer">Live demo ↗</a>
            <a class="text-link" href="/work/ai-hot-daily/">项目详情 →</a>
          </div>
        </div>
      </article>

      <article class="work-card">
        <a class="wc-media" href="/work/enterprise-ai-platform/" aria-label="查看企业 AI 平台案例">
          <div class="metric-cover" aria-hidden="true">
            <div><strong>4000+</strong><span>Platform users</span></div>
            <div><strong>17 天</strong><span>Integrate R1</span></div>
            <div><strong>10+</strong><span>MCP servers</span></div>
            <div><strong>10—15h</strong><span>Saved / week</span></div>
          </div>
        </a>
        <div class="wc-body">
          <span class="project-index">Project 03 / 2023—2026 · 内部系统</span>
          <h3 class="wc-title"><a href="/work/enterprise-ai-platform/">企业 AI 平台</a></h3>
          <p class="wc-desc">从 POC 到 4,000+ 用户的内部平台。模型接入、Agent 工具、成本治理与 MCP 生态，已脱敏。</p>
          <div class="wc-metrics">
            <span><b>3</b> 年</span>
            <span><b>4000+</b> 用户</span>
            <span><b>10+</b> MCP</span>
          </div>
          <div class="wc-links">
            <a class="text-link" href="/work/enterprise-ai-platform/">案例解析 →</a>
            <a class="text-link" href={report.demo + 'read/enterprise-case/'} target="_blank" rel="noopener noreferrer">完整案例 ↗</a>
          </div>
        </div>
      </article>
    </div>
  </section>

  <section class="shell section" id="writing">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">02</span>
        <h2 class="section-title">技术写作</h2>
      </div>
      <a class="section-note" href="/writing/">全部文章 →</a>
    </div>

    <div class="writing-list">
      {FEATURED_ARTICLES.map((article, index) => (
        <a class="writing-row" href={article.href} target="_blank" rel="noopener noreferrer">
          <span class="wr-num">{String(index + 1).padStart(2, '0')}</span>
          <span>
            <span class="wr-title">{article.title}</span>
            <span class="wr-sub">{article.subtitle}</span>
            <span class="wr-excerpt">{article.excerpt}</span>
          </span>
          <span class="wr-meta">
            <span>{article.part} · {article.minutes} min</span>
            <span class="wr-tags">
              {article.tags.map((tag) => <span class="tag">{tag}</span>)}
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="writing-footer">
      <p>以上三篇，是《从对话到协作》里最适合单独阅读的章节。</p>
      <a class="text-link" href={SITE.reportUrl} target="_blank" rel="noopener noreferrer">全系列 14 章 ↗</a>
    </div>
  </section>

  <section class="numbers">
    <div class="shell numbers-inner">
      <div class="numbers-grid">
        <div class="number">
          <strong>4000+</strong>
          <span>企业平台用户</span>
        </div>
        <div class="number">
          <strong>10+</strong>
          <span>MCP Servers 开发 / 集成</span>
        </div>
        <div class="number">
          <strong>{stats.stars}<em style="font-size:0.38em;font-style:normal;color:var(--accent)">★</em></strong>
          <span>GitHub Stars</span>
        </div>
        <div class="number">
          <strong>3</strong>
          <span>年 AI 工程实践</span>
        </div>
      </div>
      <div class="community-bar">
        <span>GitHub · {stats.stars} stars / {stats.followers} followers / {stats.repos} public repos</span>
        <span>写作 2.1 万字 · 14 章 · 17 份参考</span>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">Follow on GitHub ↗</a>
      </div>
    </div>
  </section>

  <section class="shell section" id="timeline">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">03</span>
        <h2 class="section-title">时间线</h2>
      </div>
      <span class="section-note">2022 — 2026 · 从工具到同事</span>
    </div>

    <div class="timeline">
      {TIMELINE.map((item) => (
        <div class="tl-row">
          <div class="tl-year">
            <strong>{item.year}</strong>
            <span>{item.date}</span>
          </div>
          <div class="tl-main">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
          <span class="tag tl-tag">{item.tag}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="shell section" id="about">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">04</span>
        <h2 class="section-title">关于我</h2>
      </div>
      <a class="section-note" href="/about/">完整介绍 →</a>
    </div>

    <div class="about-grid">
      <div class="about-copy">
        <p class="about-statement">做平台，也写代码。<br />把踩过的坑，写清楚。</p>
        <p>
          我是邵敏峰，一名全栈工程师。过去三年，我大部分时间在做一件事：把大模型从「演示」变成「可用的内部产品」——模型接入、Agent 工具、成本治理、权限与可观测性。
        </p>
        <p>
          我也写代码。TypeScript、Node.js、Python，从 API Gateway 到前端 Portal，从 MCP Server 到静态站点。技术选型的原则很简单：能被替换，能被审计，能被团队接手。
        </p>
        <p>
          写作是我检验理解的方式。如果一件事不能写清楚，通常说明我还没想清楚。
        </p>
        <a class="text-link" href="/about/">更多关于我 →</a>
        <div class="contact-line">
          <a href={'mailto:' + SITE.email}>Email</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href="/rss.xml">RSS</a>
        </div>
      </div>

      <div>
        <div class="skill-block">
          <h3>AI / Agent</h3>
          <ul class="skill-list">
            <li>Claude Code</li>
            <li>MCP</li>
            <li>Agent Skills</li>
            <li>RAG</li>
            <li>Prompt / Context</li>
          </ul>
        </div>
        <div class="skill-block" style="margin-top:12px">
          <h3>Engineering</h3>
          <ul class="skill-list">
            <li>TypeScript</li>
            <li>Node.js</li>
            <li>React</li>
            <li>Python</li>
            <li>Java</li>
          </ul>
        </div>
        <div class="skill-block" style="margin-top:12px">
          <h3>Platform / Security</h3>
          <ul class="skill-list">
            <li>API Gateway</li>
            <li>OIDC</li>
            <li>Docker / K8s</li>
            <li>Cost / Observability</li>
            <li>Cloud Security</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>