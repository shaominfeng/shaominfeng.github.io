---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/home.css';
import { SITE } from '../data/site';
import { PROJECTS } from '../data/projects';
import { FEATURED_ARTICLES } from '../data/articles';
import { TIMELINE } from '../data/timeline';
import { getGithubStats } from '../lib/github';

const stats = await getGithubStats();

const stages = [
  { year: '2022', label: '对话 AI' },
  { year: '2023', label: '长文本 AI' },
  { year: '2024', label: '推理 AI' },
  { year: '2025', label: 'Agent AI' },
  { year: '2026', label: '协作 AI', active: true },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  jobTitle: '全栈工程师 / AI Agent 与云安全',
  description: SITE.description,
  url: SITE.siteUrl,
  email: 'mailto:' + SITE.email,
  sameAs: [SITE.github, SITE.blogUrl],
  knowsAbout: ['AI Agent', 'MCP', 'Agent Skills', '云安全', '平台工程', 'TypeScript'],
};
---

<BaseLayout title={SITE.name} description={SITE.description} structuredData={structuredData}>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="hero-kicker">Full-stack · AI Agent / Cloud security</p>
        <h1>
          <span class="name">{SITE.name}</span>
          <span class="en">Portfolio · 2026</span>
        </h1>
        <p class="hero-line">把 AI 从「会聊天」<br />做成<em>「能干活」</em>。</p>
        <p class="hero-desc">
          3 年 AI 平台与 Agent 工程实践。做平台，也写代码；把踩过的坑，写成 2.6 万字的技术长文。
        </p>
        <div class="hero-actions">
          <a class="btn btn-light" href="/work/">看项目 <span aria-hidden="true">→</span></a>
          <a class="btn btn-outline-light" href={SITE.blogUrl}>读文章</a>
        </div>
        <p class="hero-note">
          <span>开放交流：AI Agent / 平台工程</span>
          <span>Base in China</span>
          <span>中文 / English</span>
        </p>
      </div>

      <div class="hero-visual">
        <div class="field-card">
          <div class="fc-top">
            <span>Field notes / AI</span>
            <span>2022—2026</span>
          </div>
          <ol class="stages">
            {stages.map((stage) => (
              <li class={stage.active ? 'active' : undefined}>
                <span class="yr">{stage.year}</span>
                <span class="stage">{stage.label}</span>
                <span class="dot" aria-hidden="true"></span>
              </li>
            ))}
          </ol>
          <div class="fc-foot">
            <span>Context window</span>
            <span><b>4K</b> → <b>2M</b></span>
          </div>
          <div class="fc-stat" aria-hidden="true">
            <strong>500×</strong>
            <span>Three-year growth</span>
          </div>
          <div class="seal-float" aria-hidden="true">AS</div>
        </div>
      </div>
    </div>
  </section>

  <section class="shell gateway" aria-label="主要内容">
    <a class="gateway-card gw-projects" href="/work/">
      <span class="gw-label">01 / Projects</span>
      <h2 class="gw-title">项目</h2>
      <p class="gw-desc">做过的东西。在线 Demo、内部案例，以及正在构建的新项目。</p>
      <span class="gw-foot"><span>AI HOT · 企业 AI 平台</span><span class="gw-arrow">→</span></span>
      <span class="gw-count" aria-hidden="true">02</span>
    </a>
    <a class="gateway-card gw-articles" href={SITE.blogUrl}>
      <span class="gw-label">02 / Articles</span>
      <h2 class="gw-title">文章</h2>
      <p class="gw-desc">技术长文与系列连载。14 章，另有单篇长文。</p>
      <span class="gw-foot"><span>从对话到协作 · Agentic Coding</span><span class="gw-arrow">→</span></span>
      <span class="gw-count" aria-hidden="true">15</span>
    </a>
  </section>

  <div class="ticker" aria-hidden="true">
    <div class="ticker-track">
      {Array.from({ length: 2 }).map(() => (
        <>
          <span class="ticker-item">AI Agent</span>
          <span class="ticker-item">MCP</span>
          <span class="ticker-item">Agent Skills</span>
          <span class="ticker-item">Context Engineering</span>
          <span class="ticker-item">Cloud Security</span>
          <span class="ticker-item">Developer Experience</span>
          <span class="ticker-item">2022—2026</span>
        </>
      ))}
    </div>
  </div>

  <section class="shell section" id="work">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">01</span>
        <h2 class="section-title">项目</h2>
      </div>
      <a class="section-note" href="/work/">全部项目 →</a>
    </div>

    <div class="work-grid work-grid-projects">
      {PROJECTS.map((project) => (
        <article class="work-card">
          <a class="wc-media" href={'/work/' + project.slug + '/'} aria-label={'查看项目：' + project.title}>
            {project.slug === 'ai-hot-daily' ? (
              <img src={project.cover} alt={project.coverAlt} width="1400" height="972" loading="lazy" />
            ) : (
              <div class="metric-cover" aria-hidden="true">
                {project.metrics.map((metric) => (
                  <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
                ))}
              </div>
            )}
          </a>
          <div class="wc-body">
            <span class="project-index">Project {project.index} / {project.year} · {project.status}</span>
            <h3 class="wc-title"><a href={'/work/' + project.slug + '/'}>{project.title}</a></h3>
            <p class="wc-desc">{project.tagline}</p>
            <div class="wc-metrics">
              {project.metrics.slice(0, 3).map((metric) => (
                <span><b>{metric.value}</b> {metric.label}</span>
              ))}
            </div>
            <div class="wc-links">
              {project.demo && (
                <a class="text-link" href={project.demo} target={project.demo.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                  {project.demoLabel} {project.demo.startsWith('http') ? '↗' : '→'}
                </a>
              )}
              <a class="text-link" href={'/work/' + project.slug + '/'}>详情 →</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="section-foot">
      <span>更多项目正在构建：MCP 工具集、Agent 工作流、开发者效率实验。</span>
      <a class="text-link" href="/work/">项目路线 →</a>
    </div>
  </section>

  <section class="shell section" id="writing">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">02</span>
        <h2 class="section-title">文章</h2>
      </div>
      <a class="section-note" href={SITE.blogUrl}>进入文章集 →</a>
    </div>

    <div class="writing-list">
      {FEATURED_ARTICLES.map((article, index) => (
        <a class="writing-row" href={article.href} target="_blank" rel="noopener noreferrer">
          <span class="wr-num">{String(index + 1).padStart(2, '0')}</span>
          <span>
            <span class="wr-title">{article.title}</span>
            <span class="wr-sub">{article.subtitle}</span>
            <span class="wr-excerpt">{article.excerpt}</span>
          </span>
          <span class="wr-meta">
            <span>{article.part} · {article.minutes} min</span>
            <span class="wr-tags">
              {article.tags.map((tag) => <span class="tag">{tag}</span>)}
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="writing-footer">
      <p>以上几篇，有系列里最适合单独阅读的章节，也有一篇完整的工作流长文。文章集会持续更新。</p>
      <a class="text-link" href={SITE.blogUrl} target="_blank" rel="noopener noreferrer">进入文章集 ↗</a>
    </div>
  </section>

  <section class="numbers">
    <div class="shell numbers-inner">
      <div class="numbers-grid">
        <div class="number">
          <strong>4000+</strong>
          <span>企业平台用户</span>
        </div>
        <div class="number">
          <strong>10+</strong>
          <span>MCP Servers 开发 / 集成</span>
        </div>
        <div class="number">
          <strong>{stats.stars}<em style="font-size:0.38em;font-style:normal;color:var(--accent)">★</em></strong>
          <span>GitHub Stars</span>
        </div>
        <div class="number">
          <strong>3</strong>
          <span>年 AI 工程实践</span>
        </div>
      </div>
      <div class="community-bar">
        <span>GitHub · {stats.stars} stars / {stats.followers} followers / {stats.repos} public repos</span>
        <span>写作 2.6 万字 · 14 章 + 单篇 · 17 份参考</span>
        <a href={SITE.github} target="_blank" rel="noopener noreferrer">Follow on GitHub ↗</a>
      </div>
    </div>
  </section>

  <section class="shell section" id="timeline">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">03</span>
        <h2 class="section-title">时间线</h2>
      </div>
      <span class="section-note">2022 — 2026 · 从工具到同事</span>
    </div>

    <div class="timeline">
      {TIMELINE.map((item) => (
        <div class="tl-row">
          <div class="tl-year">
            <strong>{item.year}</strong>
            <span>{item.date}</span>
          </div>
          <div class="tl-main">
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
          <span class="tag tl-tag">{item.tag}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="shell section" id="about">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">04</span>
        <h2 class="section-title">关于我</h2>
      </div>
      <a class="section-note" href="/about/">完整介绍 →</a>
    </div>

    <div class="about-grid">
      <div class="about-copy">
        <p class="about-statement">做平台，也写代码。<br />把踩过的坑，写清楚。</p>
        <p>
          我是 Allen Shao，一名全栈工程师。过去三年，我大部分时间在做一件事：把大模型从「演示」变成「可用的内部产品」——模型接入、Agent 工具、成本治理、权限与可观测性。
        </p>
        <p>
          我也写代码。TypeScript、Node.js、Python，从 API Gateway 到前端 Portal，从 MCP Server 到静态站点。技术选型的原则很简单：能被替换，能被审计，能被团队接手。
        </p>
        <p>
          写作是我检验理解的方式。如果一件事不能写清楚，通常说明我还没想清楚。
        </p>
        <a class="text-link" href="/about/">更多关于我 →</a>
        <div class="contact-line">
          <a href={'mailto:' + SITE.email}>Email</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
          <a href={SITE.blogUrl}>文章集</a>
        </div>
      </div>

      <div>
        <div class="skill-block">
          <h3>AI / Agent</h3>
          <ul class="skill-list">
            <li>Claude Code</li>
            <li>MCP</li>
            <li>Agent Skills</li>
            <li>RAG</li>
            <li>Prompt / Context</li>
          </ul>
        </div>
        <div class="skill-block" style="margin-top:12px">
          <h3>Engineering</h3>
          <ul class="skill-list">
            <li>TypeScript</li>
            <li>Node.js</li>
            <li>React</li>
            <li>Python</li>
            <li>Java</li>
          </ul>
        </div>
        <div class="skill-block" style="margin-top:12px">
          <h3>Platform / Security</h3>
          <ul class="skill-list">
            <li>API Gateway</li>
            <li>OIDC</li>
            <li>Docker / K8s</li>
            <li>Cost / Observability</li>
            <li>Cloud Security</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>