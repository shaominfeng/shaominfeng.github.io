---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS } from '../../data/projects';
import { SITE } from '../../data/site';

export async function getStaticPaths() {
  return PROJECTS.map((project, index) => ({
    params: { slug: project.slug },
    props: {
      project,
      next: PROJECTS[(index + 1) % PROJECTS.length],
    },
  }));
}

const { project, next } = Astro.props;
const index = PROJECTS.findIndex((item) => item.slug === project.slug);

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  alternateName: project.en,
  description: project.description,
  dateCreated: project.year,
  creator: {
    '@type': 'Person',
    name: SITE.name,
    alternateName: SITE.en,
    url: SITE.siteUrl,
  },
  url: new URL('/work/' + project.slug + '/', Astro.site).toString(),
  keywords: project.stack.join(', '),
};
---

<BaseLayout title={project.title} description={project.description} type="article" structuredData={structuredData}>
  <div class="shell case-hero">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href="/">首页</a>
      <span>/</span>
      <a href="/work/">项目</a>
      <span>/</span>
      <span>{String(index + 1).padStart(2, '0')}</span>
    </nav>

    <span class="case-label">Project {project.index} · {project.en}</span>
    <h1>{project.title}</h1>
    <p class="case-tagline">{project.tagline}</p>
    <p class="case-desc">{project.description}</p>

    <dl class="case-meta">
      <div><dt>Year</dt><dd>{project.year}</dd></div>
      <div><dt>Role</dt><dd>{project.role}</dd></div>
      <div><dt>Status</dt><dd>{project.status}</dd></div>
      <div><dt>Stack</dt><dd>{project.stack.join(' · ')}</dd></div>
    </dl>
  </div>

  {project.cover && (
    <div class="shell">
      <figure class="case-cover">
        <img src={project.cover} alt={project.coverAlt} width="1400" height="764" loading="eager" />
        <figcaption>
          <span>{project.coverCaption}</span>
          <span>{project.en}</span>
        </figcaption>
      </figure>
    </div>
  )}

  <div class="shell case-grid">
    <aside class="case-side">
      <ul class="info-list">
        <li><dt>项目</dt><dd>{project.title}</dd></li>
        <li><dt>时间</dt><dd>{project.year}</dd></li>
        <li><dt>角色</dt><dd>{project.role}</dd></li>
        <li><dt>状态</dt><dd>{project.status}</dd></li>
        <li><dt>技术</dt><dd>{project.stack.join(', ')}</dd></li>
      </ul>
      {project.demo ? (
        <a class="text-link" href={project.demo} target={project.demo.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
          {project.demoLabel} ↗
        </a>
      ) : (
        <span class="case-note">{project.note}</span>
      )}
      {project.repo && (
        <a class="text-link" style="margin-left:16px" href={project.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>
      )}
    </aside>

    <div class="case-main">
      <div class="case-metrics">
        {project.metrics.map((metric) => (
          <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
        ))}
      </div>

      {project.sections.map((section) => (
        <section class="case-section">
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && (
            <ul>
              {section.bullets.map((bullet) => <li>{bullet}</li>)}
            </ul>
          )}
        </section>
      ))}

      <div class="case-links">
        {project.demo && (
          <a class="btn btn-primary" href={project.demo} target={project.demo.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
            {project.demoLabel} <span aria-hidden="true">→</span>
          </a>
        )}
        {project.repo && (
          <a class="btn btn-ghost" href={project.repo} target="_blank" rel="noopener noreferrer">源代码 ↗</a>
        )}
        <a class="btn btn-ghost" href="/work/">全部项目</a>
      </div>

      {project.note && <p class="case-note">{project.note}</p>}

      <a class="next-project" href={'/work/' + next.slug + '/'}>
        <div>
          <small>Next project</small>
          <strong>{next.title} →</strong>
        </div>
        <span class="mono">{next.index}</span>
      </a>
    </div>
  </div>
</BaseLayout>