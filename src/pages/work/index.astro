---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PROJECTS } from '../../data/projects';
import { SITE } from '../../data/site';
---

<BaseLayout
  title="作品"
  description="邵敏峰的作品：AI 演进报告、AI HOT 每日晨报、企业 AI 平台。每个项目都有可访问的在线 Demo 或完整案例。"
>
  <div class="shell page-hero">
    <p class="label">Work / 2023—2026</p>
    <h1>作品</h1>
    <p>
      三个项目，三种尺度：一份 2.1 万字的公开报告，一个每天更新的小工具，一个 4,000+ 用户的企业平台。
      共同点是——都从真实问题出发，也都留下了可以复用的方法。
    </p>
    <div class="page-meta">
      <span>{PROJECTS.length} 个项目</span>
      <span>2 个在线 Demo</span>
      <span>1 个企业案例（脱敏）</span>
    </div>
  </div>

  <section class="shell section">
    <div class="work-list">
      {PROJECTS.map((project) => (
        <article class="work-feature">
          <div class="wf-copy">
            <span class="project-index">Project {project.index} / {project.year} · {project.status}</span>
            <h2 class="wf-title"><a href={'/work/' + project.slug + '/'}>{project.title}</a></h2>
            <p class="wf-tagline">{project.tagline}</p>
            <p class="wf-desc">{project.description}</p>
            <div class="wf-metrics">
              {project.metrics.slice(0, 3).map((metric) => (
                <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
              ))}
            </div>
            <div class="wf-links">
              {project.demo && (
                <a class="text-link" href={project.demo} target={project.demo.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer">
                  {project.demoLabel} ↗
                </a>
              )}
              <a class="text-link" href={'/work/' + project.slug + '/'}>项目详情 →</a>
              {project.repo && <a class="text-link" href={project.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a>}
            </div>
          </div>
          <a class="wf-media" href={'/work/' + project.slug + '/'} aria-label={'查看项目：' + project.title}>
            {project.cover ? (
              <img src={project.cover} alt={project.coverAlt} loading="lazy" />
            ) : (
              <div class="metric-cover" aria-hidden="true">
                {project.metrics.map((metric) => (
                  <div><strong>{metric.value}</strong><span>{metric.label}</span></div>
                ))}
              </div>
            )}
            <span class="media-caption">{project.coverCaption ?? project.en}</span>
          </a>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
