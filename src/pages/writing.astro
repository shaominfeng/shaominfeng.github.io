---
import BaseLayout from '../layouts/BaseLayout.astro';
import { FEATURED_ARTICLES, SERIES_CHAPTERS } from '../data/articles';
import { SITE } from '../data/site';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE.name + ' · 技术写作',
  description: 'AI Agent、上下文工程、推理层与企业实践。',
  url: new URL('/writing/', Astro.site).toString(),
  author: { '@type': 'Person', name: SITE.name, url: SITE.siteUrl },
};
---

<BaseLayout title="写作" description="邵敏峰的技术写作：上下文革命、Agent Skills、推理层，以及《从对话到协作》全系列。" structuredData={structuredData}>
  <div class="shell page-hero">
    <p class="label">Writing / 2026</p>
    <h1>写作</h1>
    <p>
      写作是我检验理解的方式。如果一件事不能写清楚，通常说明我还没想清楚。
      这里放长文：技术原理、架构判断，以及从企业实践里带回来的经验。
    </p>
    <div class="page-meta">
      <span>3 篇深度解析</span>
      <span>1 个 14 章系列</span>
      <span>约 2.1 万字</span>
      <a href="/rss.xml">RSS</a>
    </div>
  </div>

  <section class="shell section">
    <div class="section-head">
      <div class="section-head-left">
        <span class="section-index">01</span>
        <h2 class="section-title">深度解析</h2>
      </div>
      <span class="section-note">Long reads</span>
    </div>

    <div class="writing-list">
      {FEATURED_ARTICLES.map((article, index) => (
        <a class="writing-row" href={article.href} target="_blank" rel="noopener noreferrer">
          <span class="wr-num">{String(index + 1).padStart(2, '0')}</span>
          <span>
            <span class="wr-title">{article.title}</span>
            <span class="wr-sub">{article.subtitle}</span>
            <span class="wr-excerpt">{article.excerpt}</span>
          </span>
          <span class="wr-meta">
            <span>{article.part} · {article.minutes} min</span>
            <span class="wr-tags">
              {article.tags.map((tag) => <span class="tag">{tag}</span>)}
            </span>
          </span>
        </a>
      ))}
    </div>

    <div class="writing-footer">
      <p>这三篇都来自同一个系列，可以单独读，也可以按顺序读。</p>
      <a class="text-link" href={SITE.reportUrl} target="_blank" rel="noopener noreferrer">打开完整报告 ↗</a>
    </div>
  </section>

  <section class="shell section">
    <div class="series">
      <div class="series-head">
        <h2>系列：从对话到协作</h2>
        <a class="section-note" href={SITE.reportUrl} target="_blank" rel="noopener noreferrer">14 章 · 在线阅读 ↗</a>
      </div>
      <div class="series-list">
        {SERIES_CHAPTERS.map((chapter) => (
          <a class="series-row" href={chapter.href} target="_blank" rel="noopener noreferrer">
            <span class="sr-num">{String(chapter.num).padStart(2, '0')}</span>
            <span class="sr-title">{chapter.title}</span>
            <span class="sr-meta">{chapter.minutes} min</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
